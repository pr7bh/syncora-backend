# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
DATABASE_NAME=syncora

# Auth
JWT_SECRET=<generate with: python3 -c "import secrets; print(secrets.token_hex(32))">
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Google OAuth (server-side token verification)
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com

# AI
GEMINI_API_KEY=<your-gemini-api-key>
GROQ_API_KEY=<your-groq-api-key>

# YouTube transcript providers
# SUPADATA_API_KEY is optional but recommended — enables the Supadata fallback provider.
# Without it, the app falls back to timedtext then youtube-transcript-api (blocked on most cloud IPs).
# Free plan available at https://supadata.ai
SUPADATA_API_KEY=<your-supadata-api-key-optional>

# Cloudinary (profile pictures)
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# CORS – comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://syncora-by-prabh.vercel.app

# ChromaDB – set to a persistent-disk mount on cloud hosts (e.g. /data/chroma_db on Render)
CHROMA_PATH=./chroma_db

# File upload limit (MB)
MAX_UPLOAD_MB=100

# Admin endpoint secret
ADMIN_SECRET=<generate with: python3 -c "import secrets; print(secrets.token_hex(32))">
